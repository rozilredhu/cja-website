{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cja-website",
  "main": ".open-next/worker.js",
  // Compatibility date for Workers runtime (keep recent)
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Public / non-secret defaults. Put TURNSTILE_SECRET_KEY via `wrangler secret put`.
  "vars": {
    "TURNSTILE_BYPASS": "true"
  },
  // Local / default: existing D1 `cja-db`
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cja-db",
      "database_id": "5c136fb8-3e90-40de-ba91-76fd5fd763d3",
      "migrations_dir": "migrations"
    }
  ],
  // R2: account must enable R2 in the dashboard before adding bindings.
  // Re-add when ready, e.g.:
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "cja-website-media" }]
  "env": {
    "staging": {
      "name": "cja-website-staging",
      "vars": {
        "TURNSTILE_BYPASS": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cja-website-db-staging",
          "database_id": "6e76599c-f60c-4b3e-b0f0-9056e233c381",
          "migrations_dir": "migrations"
        }
      ]
      // R2 omitted until R2 is enabled on the Cloudflare account
    },
    "production": {
      "name": "cja-website-production",
      "vars": {
        "TURNSTILE_BYPASS": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cja-website-db-production",
          "database_id": "cd650b4c-e85b-4402-8964-755128d4c608",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
