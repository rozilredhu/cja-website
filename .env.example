# Public site URL (used for metadata / sitemap). Staging default:
NEXT_PUBLIC_SITE_URL=https://draft.cjacanada.ca

# Cloudflare Turnstile (bot protection) — placeholders only; do not commit real keys
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# When true (or when keys are empty), public forms skip Turnstile verification.
# Use for local/dev only. Never enable on production.
TURNSTILE_BYPASS=true

# Stripe (optional — NOT required for Phase 1 stub). Never commit real keys.
# When set, a future StripeAdapter can replace StripeStubAdapter.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=
